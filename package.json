    "vinext": "1.0.0-beta.9",
    "drizzle-orm": "0.45.2",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
