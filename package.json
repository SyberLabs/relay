{
  "name": "syberlabs-relay",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --port 8787 --persist-to .wrangler/state",
    "lint": "oxlint app lib db tests scripts deploy",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/ci/run-unit.mjs",
    "context:check": "node scripts/agent-context.mjs --check",
    "typecheck": "tsc --noEmit",
    "test:api": "node scripts/ci/run-integration.mjs api",
    "test:calibration": "node scripts/ci/run-integration.mjs calibration",
    "test:orchestration": "node scripts/ci/run-integration.mjs orchestration",
    "test:cli": "node scripts/ci/run-integration.mjs cli",
    "test:e2e": "node scripts/ci/run-integration.mjs browser",
    "test:production": "node scripts/ci/run-production.mjs",
    "relay": "node integrations/relay.mjs",
    "public-copy:sync": "node scripts/sync-public-copy.mjs --target project --root .",
    "public-copy:check": "node scripts/sync-public-copy.mjs --target project --root . --check",
    "ensure-node": "node scripts/ensure-node.mjs",
    "predev": "node scripts/ensure-node.mjs",
    "prestart": "node scripts/ensure-node.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "csv-parse": "7.0.2",
    "jose": "6.2.12",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260904.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "bin": {
    "relay": "integrations/relay.mjs"
  }
}
