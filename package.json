    "test:e2e": "node scripts/ci/run-integration.mjs browser",
    "test:production": "node scripts/ci/run-production.mjs",
    "relay": "node integrations/relay.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
